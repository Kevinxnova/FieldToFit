# MiniMax API key (for AI recommendations)
MINIMAX_API_KEY=

# Buttondown newsletter API key
BUTTONDOWN_API_KEY=

# Product Hunt API token (optional, scraper will skip if empty)
PRODUCTHUNT_API_TOKEN=

# Turso database (optional; leave empty to use local SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional LibreTranslate-compatible /translate endpoint
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

# API settings
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Admin password (required to access /admin)
ADMIN_PASSWORD=

# Required for every /api/cron/* request
CRON_SECRET=

# Deployment: comma-separated allowed origins for CORS
# Add your Vercel URL here after deploying, e.g.:
# ALLOWED_ORIGINS=https://fieldtofit-xxx.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Knowledge workspace (all source checks run every 1 day)
# Optional private read access. Web settings and MCP clients must supply this token.
FIELDTOFIT_READ_TOKEN=
# Current release: public registration stays closed. Keep this switch at 0.
FIELDTOFIT_PUBLIC_ACCOUNTS=0
# Optional separate database directory; leave unset to retain data/fieldtofit.db.
# FIELDTOFIT_DATA_DIR=/absolute/path/to/fieldtofit-data
# Optional authenticated GitHub collection (public repositories only).
GITHUB_TOKEN=
# Optional MCP stdio bridge endpoint.
FIELDTOFIT_MCP_URL=http://127.0.0.1:8000/api/mcp

# Optional automatic knowledge organization (credentials are separate from Codex sign-in).
# GPT example: use Responses and a model available to your API account.
FIELDTOFIT_MODEL_API_KEY=
FIELDTOFIT_MODEL_BASE_URL=https://api.openai.com/v1
FIELDTOFIT_MODEL_NAME=gpt-6-astra
FIELDTOFIT_MODEL_API_STYLE=responses
# Without a model API key, source browsing and the bundled GPT batch remain usable.
# Other providers: set URL/model and use chat_completions when supported.
FIELDTOFIT_DAILY_RECORD_LIMIT=300
FIELDTOFIT_DAILY_PROCESS_SECONDS=3600
# 每日无服务器整理批次上限；检查频率仍为 1 天
FIELDTOFIT_CRON_RECORD_LIMIT=30
